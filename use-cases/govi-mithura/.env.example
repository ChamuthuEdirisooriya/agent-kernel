# -----------------------------------------------------------------------------
# LLM provider - primary portable setup
# -----------------------------------------------------------------------------
# This path works with OpenAI and any provider that exposes an OpenAI-compatible
# chat-completions endpoint. Replace all placeholders with values from your provider.
LLM_PROVIDER=openai_compatible
LLM_MODEL=YOUR_MODEL_ID
LLM_API_KEY=
LLM_BASE_URL=https://YOUR_PROVIDER_HOST/v1

# Bound each model attempt. LLM_MAX_RETRIES counts retries after the initial request.
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# -----------------------------------------------------------------------------
# Optional Google AI Studio setup
# -----------------------------------------------------------------------------
# Create a key at https://aistudio.google.com/apikey, then replace the active
# provider block above with these values. GOOGLE_API_KEY and LLM_API_KEY are
# accepted aliases for GEMINI_API_KEY.
# Free-tier limits are per project and vary by model across requests per minute,
# tokens per minute, and requests per day. A Govi Mithura turn can use multiple
# model requests, so verify the current limits at https://ai.dev/rate-limit.
# gemini-3.5-flash is the conservative AI Studio choice for this workload;
# re-test latency and quota behavior before selecting a newer model.
#
# LLM_PROVIDER=google_ai_studio
# LLM_MODEL=gemini-3.5-flash
# LLM_THINKING_LEVEL=low
# GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Optional Vertex AI setup
# -----------------------------------------------------------------------------
# Local authentication:
#   gcloud auth application-default login --project=YOUR_PROJECT_ID
# Cloud Run should use a dedicated service account instead of a static model key.
# gemini-3.6-flash is used here because it gave the most consistent latency for
# this tool-calling workload on Vertex during development testing.
#
# LLM_PROVIDER=google_vertex
# LLM_MODEL=gemini-3.6-flash
# LLM_THINKING_LEVEL=low
# GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
# GOOGLE_CLOUD_LOCATION=global

# -----------------------------------------------------------------------------
# Session storage
# -----------------------------------------------------------------------------
# config.yaml uses in-memory sessions by default. A Firestore deployment can
# override that configuration with the following variables.
#
# AK_SESSION__TYPE=firestore
# AK_SESSION__FIRESTORE__COLLECTION_NAME=govi-mithura-sessions
# AK_SESSION__FIRESTORE__PROJECT_ID=YOUR_PROJECT_ID
# AK_SESSION__FIRESTORE__DATABASE_ID=(default)
# AK_SESSION__FIRESTORE__TTL=604800

# -----------------------------------------------------------------------------
# Field-information behavior
# -----------------------------------------------------------------------------
WEATHER_REQUEST_TIMEOUT_SECONDS=10
MARKET_PRICE_STALE_AFTER_DAYS=7

# -----------------------------------------------------------------------------
# WhatsApp Cloud API - required only for server.py
# -----------------------------------------------------------------------------
# Leave credentials empty in source control. Use a secret manager in hosted environments.
AK_WHATSAPP__VERIFY_TOKEN=
AK_WHATSAPP__ACCESS_TOKEN=
AK_WHATSAPP__APP_SECRET=
AK_WHATSAPP__PHONE_NUMBER_ID=
AK_WHATSAPP__API_VERSION=v25.0
